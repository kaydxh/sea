#
# NOTE! Please use 'git ls-files -i --exclude-standard'
# command after changing this file, to see if there are
# any tracked files which get ignored after the change.
#

# === Build outputs ===
pack/
cmd/*/sea-date
*.exe

# === Logs & runtime ===
*.log
log/
cmd/log/

# === Generated proto files (regenerated by `make generate`) ===
api/protoapi-spec/**/*.pb.go
api/protoapi-spec/**/*.pb.gw.go
api/protoapi-spec/**/*_grpc.pb.go

# === Auto-downloaded scripts (refreshed by `make generate`) ===
script/proto-gen.sh
script/third_party/

# === IDE & AI tools ===
.vscode/
.idea/
.codebuddy/
.DS_Store
.agent

# === Compiled objects ===
*.o
*.l[ao]
*.d
!**/tmpfiles.d
!crosh/dev.d
*.depends
.deps
.libs
*.gch
*.gcda
*.gcno

# === Common output files ===
*.dump
*.out
*.test

# === Temp files (editors) ===
*~
*.sw[op]

# === Python ===
*.pyc

# === Debug (gdb) ===
.gdb_history
.gdbinit
core
cscope.*
tags
tags_sorted_by_file

# === Patch files ===
*.diff
*.patch
*.orig
*.rej

# === Misc ===
.clangd
.cache
Cargo.lock
target/
